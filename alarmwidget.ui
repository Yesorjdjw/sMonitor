  <property name="styleSheet"><string notr="true">
QWidget#AlarmWidget { background-color: #f8f9fc; font-family: "Microsoft YaHei",sans-serif; }

QFrame#sideBar { background: #ffffff; border: 1px solid #DDE3EE; border-radius: 8px; }
QWidget#sideTitleBar { background-color: #E8F0FC; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom: 1px solid #DDE3EE; }
QLabel#sideTitle { color: #333333; font-size: 14px; font-weight: bold; background: transparent; }
QLabel#badgeTotal { background: #D93025; color: #ffffff; font-size: 10px; font-weight: bold; border-radius: 9px; min-width: 18px; min-height: 18px; max-width: 18px; max-height: 18px; }

QPushButton#catBtn1, QPushButton#catBtn2, QPushButton#catBtn3, QPushButton#catBtn4, QPushButton#catBtn5 {
  background: transparent; border: none; border-left: 3px solid transparent;
  text-align: left; font-size: 13px; color: #333333; padding: 10px 12px; border-radius: 4px;
}
QPushButton#catBtn1:hover, QPushButton#catBtn2:hover, QPushButton#catBtn3:hover, QPushButton#catBtn4:hover, QPushButton#catBtn5:hover {
  background: #f0f4f8;
}
QPushButton#catBtn1[selected=true], QPushButton#catBtn2[selected=true], QPushButton#catBtn3[selected=true],
QPushButton#catBtn4[selected=true], QPushButton#catBtn5[selected=true] {
  background: rgba(64,123,255,0.10); border-left: 3px solid #407BFF; font-weight: 600; color: #1a3a6a;
}

QLabel#badge1, QLabel#badge2 { background: #D93025; color: #ffffff; font-size: 10px; font-weight: bold; border-radius: 9px; min-width: 18px; min-height: 18px; max-width: 18px; max-height: 18px; }
QLabel#badge3, QLabel#badge4 { background: #F29927; color: #ffffff; font-size: 10px; font-weight: bold; border-radius: 9px; min-width: 18px; min-height: 18px; max-width: 18px; max-height: 18px; }
QLabel#badge5 { background: #2774D9; color: #ffffff; font-size: 10px; font-weight: bold; border-radius: 9px; min-width: 18px; min-height: 18px; max-width: 18px; max-height: 18px; }


QFrame#mainArea { background: #ffffff; border: 1px solid #DDE3EE; border-radius: 8px; }
QWidget#mainTitleBar { background-color: #E8F0FC; border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom: 1px solid #DDE3EE; }
QLabel#mainTitle { color: #333333; font-size: 14px; font-weight: bold; background: transparent; }
QLabel#countText { color: #666666; font-size: 12px; background: transparent; }

QFrame#filterBar { background: #ffffff; border-bottom: 1px solid #f0f0f0; }
QLabel#timeLabel, QLabel#levelLabel { font-size: 12px; color: #666666; background: transparent; }
QComboBox#timeCombo, QComboBox#levelCombo, QComboBox#pageSizeCombo { font-size: 12px; }
QLineEdit#keywordEdit { font-size: 12px; }

QPushButton#searchBt { background-color: #407BFF; color: white; border: none; border-radius: 4px; padding: 6px 16px; font-size: 12px; font-weight: bold; }
QPushButton#searchBt:hover { background-color: #3570e5; }
QPushButton#refreshBt { background-color: #E8F0FC; color: #333333; border: 1px solid #DDE3EE; border-radius: 4px; padding: 6px 12px; font-size: 12px; }
QPushButton#refreshBt:hover { background-color: #d0ddf0; }
QPushButton#exportBt { background-color: #ffffff; color: #407BFF; border: 1px solid #407BFF; border-radius: 4px; padding: 6px 12px; font-size: 12px; }
QPushButton#exportBt:hover { background-color: #E8F0FC; }

QHeaderView::section { background: #E8F0FC; color: #333333; font-size: 13px; font-weight: bold; border: none; border-bottom: 1px solid #DDE3EE; padding: 10px 12px; }
QTableWidget#eventTable { background: #ffffff; border: none; font-size: 13px; color: #333333; gridline-color: #f0f0f0; }
QTableWidget#eventTable::item { padding: 8px 12px; border-bottom: 1px solid #f5f5f5; }
QTableWidget#eventTable::item:hover { background: #f8f9fb; }
QTableWidget#eventTable::item:selected { background: #c8ddf8; color: #333333; }

QLabel#emptyIcon { background: transparent; font-size: 48px; }
QLabel#emptyLabel { color: #999999; font-size: 14px; background: transparent; border: none; }

QFrame#pageBar { background: #fafbfc; border-top: 1px solid #f0f0f0; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; }
QPushButton#prevBt, QPushButton#nextBt {
  background: #ffffff; color: #333333; border: 1px solid #DDE3EE; border-radius: 4px; padding: 4px 12px; font-size: 12px;
}
QPushButton#prevBt:hover, QPushButton#nextBt:hover { background: #E8F0FC; border-color: #407BFF; }
QPushButton#prevBt:disabled, QPushButton#nextBt:disabled { color: #cccccc; background: #f5f5f5; }
QLabel#pageLabel { color: #666666; font-size: 12px; }
QLabel#pageSizeLabel { color: #666666; font-size: 12px; }

QPushButton#ackBt { background-color: #407BFF; color: white; border: none; border-radius: 6px; padding: 8px 24px; font-size: 13px; font-weight: bold; }
QPushButton#ackBt:hover { background-color: #3570e5; }
QPushButton#clearBt { background-color: #ffffff; color: #D93025; border: 1px solid #D93025; border-radius: 6px; padding: 8px 24px; font-size: 13px; }
QPushButton#clearBt:hover { background-color: #fef0f0; }
