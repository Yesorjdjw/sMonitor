/* =========================================
   sMonitor Global StyleSheet
========================================= */

/* menu.cpp */
#get_vedio_bt[recording="true"] {
    background: rgba(255,59,48,0.5);
    border: 1px solid rgba(255,59,48,0.8);
    border-radius: 16px;
    font-size: 12px;
}

#get_vedio_bt[recording="false"] {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 16px;
    font-size: 12px;
}

QLabel#thumb_animation {
    background: #1a1a1a;
    border: 2px solid rgba(255,255,255,0.5);
    border-radius: 6px;
}

/* setup.cpp */
QPushButton[navSelected="true"] {
    background: #e8f0fe;
    border: none;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    color: #333333;
    padding-left: 44px;
}

QPushButton[navSelected="false"] {
    background: transparent;
    border: none;
    text-align: left;
    font-size: 13px;
    font-weight: 500;
    color: #333333;
    padding-left: 44px;
}

#videoSeg[hasVideo="true"] {
    background: #1a7bbd;
    border-top-left-radius: 7px;
    border-bottom-left-radius: 7px;
}

#videoSeg[hasVideo="false"] {
    background: transparent;
}

/* unusual.cpp */
QPushButton[catSelected="true"] {
    background: rgba(0,180,255,0.2);
    border: none;
    border-radius: 0px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    color: #333333;
    padding-left: 52px;
}

QPushButton[catSelected="false"] {
    background: transparent;
    border: none;
    border-radius: 0px;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    color: #333333;
    padding-left: 52px;
}
